{
  "name": "thinking-canvas-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "vitest",
    "migrate:local": "supabase db push --local",
    "migrate:prod": "supabase db push --linked",
    "gen:types:local": "supabase gen types typescript --local > src/db/database.types.ts",
    "gen:types:prod": "supabase gen types typescript --linked > src/db/database.types.ts",
    "inngest:dev": "npx inngest-cli@latest dev",
    "seed:prompts": "tsx --env-file=.env scripts/seed-prompts.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "latest",
    "@hono/node-server": "^2.0.4",
    "@langfuse/client": "^5.5.3",
    "@mastra/core": "latest",
    "@mastra/langfuse": "^1.4.0",
    "@mastra/observability": "^1.15.0",
    "@supabase/supabase-js": "latest",
    "@upstash/redis": "latest",
    "ai": "^6.0.201",
    "dotenv": "^17.4.2",
    "hono": "latest",
    "inngest": "^4.7.0",
    "stripe": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^20",
    "inngest-cli": "^1.31.0",
    "supabase": "^2.105.0",
    "tsx": "latest",
    "typescript": "^5",
    "vitest": "latest"
  }
}
